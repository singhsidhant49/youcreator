# LLM Providers (DeepSeek / OpenAI)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=your_openai_api_key_here

# Speech Synthesis (Kokoro Captioned TTS)
KOKORO_TTS_URL=http://localhost:8880
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# Stock Media Discovery (Pexels)
PEXELS_API_KEY=your_pexels_api_key_here

# AI Image Generation (Ideogram)
IDEOGRAM_API_KEY=your_ideogram_api_key_here
IDEOGRAM_QUALITY=high
IDEOGRAM_RESOLUTION=1k

# Factual Web Research (Brave Search)
BRAVE_SEARCH_KEY=your_brave_search_api_key_here

# Rendering & Server Configuration
OUTPUT_FPS=30
PORT=3000
