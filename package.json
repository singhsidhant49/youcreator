{
  "name": "youcreator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:job": "tsx apps/cli/src/test-job.ts",
    "cli": "tsx --env-file=.env apps/cli/src/index.ts",
    "cli:pipeline": "tsx --env-file=.env apps/cli/src/index.ts",
    "script:smoke": "tsx apps/cli/src/script-smoke.ts",
    "accept:production": "tsx apps/cli/src/production-acceptance-runner.ts",
    "accept:mode-b": "tsx --env-file=.env apps/cli/src/mode-b-acceptance-runner.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.535",
    "@remotion/renderer": "^4.0.535",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.535",
    "zod": "^4.0.0"
  }
}
